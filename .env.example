# =============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example) - AUX CAD / IM3 BRASIL
# Copie este arquivo para .env e preencha com suas credenciais de acesso locais.
# =============================================================================

# --- CREDENCIAIS CORPORATIVAS COMPARTILHADAS (GOMNET + SISTEMAS ÚTEIS) ---
# Estas mesmas credenciais são utilizadas para acessar:
# 1) GOMNET
# 2) Árvore de Dispositivos (Caminho Elétrico)
# 3) Sistema de Universalização (Ordens e Clientes)
GOMNET_LOGIN="SEU_LOGIN_AQUI"
GOMNET_SENHA="SUA_SENHA_AQUI"
GOMNET_URL="http://gomnet-rj.enelint.global/login.aspx"

# Aliases de conveniência para automações e robôs de consulta
DISTRIBUIDORA_LOGIN="SEU_LOGIN_AQUI"
DISTRIBUIDORA_SENHA="SUA_SENHA_AQUI"

# --- GOM (Módulo de Orçamento e Contratos) ---
GOM_ORCAMENTO_ID="SEU_ID_AQUI"
GOM_ORCAMENTO_SENHA="SUA_SENHA_AQUI"
GOM_ORCAMENTO_CONTRATO="CONTRATO_AQUI"

# --- SISTEMAS ÚTEIS (Acessados com o mesmo login/senha do GOMNET acima) ---
# Consulta para localizar o dispositivo de proteção / caminho elétrico
URL_ARVORE_DISPOSITIVOS="http://sgt.rio.e-corpnet.org/caminhoeletrico/Arvore.aspx"

# Consulta de ordens e dados do cliente / universalização
URL_SISTEMA_UNIVERSALIZACAO="http://gtecprorio.enelint.global/sistemas/universalizacao/"

# --- ACESSO AO SHAREPOINT (Módulo SOB / Levantamentos de Campo) ---
SHAREPOINT_ID="seu_usuario@hbtengenharia.com.br"
SHAREPOINT_SENHA="sua_senha_aqui"
# Link da pasta de Levantamentos de Campo da HBT Enel Rio
SHAREPOINT_URL="https://hbtengenharia1.sharepoint.com/:f:/s/HBT-EnelRJ-Sul/IgALh51uFX0fRovCUeVsprYWAWYGyn7GwehC6BrYpg9KcFc?e=ltJeMr"

