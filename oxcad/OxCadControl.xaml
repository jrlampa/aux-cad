<UserControl x:Class="OxCad.OxCadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="360"
             Background="#1E1E24" Foreground="#E0E0E6"
             FontFamily="Segoe UI, Tahoma, sans-serif" FontSize="12">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Separator -->
            <RowDefinition Height="*"/>    <!-- Content / Cards -->
            <RowDefinition Height="Auto"/> <!-- Action Status Bar -->
            <RowDefinition Height="Auto"/> <!-- Refresh Button -->
            <RowDefinition Height="Auto"/> <!-- Footer / Version -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="ImgLogoHeader" Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="OXCAD" FontSize="20" FontWeight="Bold" Foreground="#4EA8DE" />
                <TextBlock Text="Ambiente Integrado de Automação CAD" FontSize="11" Foreground="#9E9EB0" Margin="0,1,0,0" />
            </StackPanel>
        </Grid>

        <!-- DIVIDER -->
        <Border Grid.Row="1" Height="1" Background="#2E2E38" Margin="0,0,0,10"/>

        <!-- CONTEXT CARDS -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- CARD ALERTA DE INCONSISTÊNCIA -->
                <Border x:Name="CardInconsistencia" Background="#3D2B1F" BorderBrush="#E76F51" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚠ Inconsistência de contexto" FontSize="12" FontWeight="Bold" Foreground="#F4A261" />
                        <TextBlock x:Name="TxtInconsistenciaMsg" Text="DWG: SOB_A | Workspace: SOB_B" FontSize="11" Foreground="#FFFFFF" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- SEÇÃO AÇÕES DE ENGENHARIA (DISPATCHER) -->
                <TextBlock Text="AÇÕES DE ENGENHARIA" FontSize="10" FontWeight="SemiBold" Foreground="#7E7E94" Margin="0,0,0,6" />

                <Border Background="#252532" CornerRadius="6" Padding="8" BorderBrush="#353544" BorderThickness="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CQT -->
                        <Button x:Name="BtnCqt" Grid.Row="0" Grid.Column="0" Content="⚡ CQT" Height="30" Margin="2"
                                Background="#2A3B4C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                                Cursor="Hand" Click="BtnAcao_Click" Tag="cqt" />

                        <!-- Orçamento -->
                        <Button x:Name="BtnOrcamento" Grid.Row="0" Grid.Column="1" Content="📊 Orçamento" Height="30" Margin="2"
                                Background="#2A3B4C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                                Cursor="Hand" Click="BtnAcao_Click" Tag="orcamento" />

                        <!-- CPFC -->
                        <Button x:Name="BtnCpfc" Grid.Row="1" Grid.Column="0" Content="📐 CPFC" Height="30" Margin="2"
                                Background="#2A3B4C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                                Cursor="Hand" Click="BtnAcao_Click" Tag="cpfc" />

                        <!-- Ambiental -->
                        <Button x:Name="BtnAmbiental" Grid.Row="1" Grid.Column="1" Content="🌿 Ambiental" Height="30" Margin="2"
                                Background="#2A3B4C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                                Cursor="Hand" Click="BtnAcao_Click" Tag="ambiental" />

                        <!-- AutoPrancha -->
                        <Button x:Name="BtnPrancha" Grid.Row="2" Grid.Column="0" Content="📐 AutoPrancha" Height="30" Margin="2"
                                Background="#2A3B4C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                                Cursor="Hand" Click="BtnAcao_Click" Tag="prancha" />

                        <!-- Preparar SOB -->
                        <Button x:Name="BtnSob" Grid.Row="2" Grid.Column="1" Content="📁 Preparar SOB" Height="30" Margin="2"
                                Background="#2A3B4C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                                Cursor="Hand" Click="BtnAcao_Click" Tag="sob" />

                        <!-- Levantamento genérico de condutores -->
                        <Button x:Name="BtnLevantamentoCondutores" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="📏 Levantar Condutores" Height="30" Margin="2"
                            Background="#315442" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                            Cursor="Hand" Click="BtnLevantarCondutores_Click" />

                        <Button x:Name="BtnValidar" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="✓ Validar Entregáveis" Height="30" Margin="2"
                            Background="#37645A" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                            Cursor="Hand" Click="BtnAcao_Click" Tag="validar" />
                    </Grid>
                </Border>

                <StackPanel x:Name="PainelValidacao" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="VALIDAÇÃO TÉCNICA" FontSize="10" FontWeight="SemiBold" Foreground="#7E7E94" Margin="0,0,0,6" />
                    <TextBlock x:Name="TxtValidationSummary" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#E2E2EC" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <ItemsControl x:Name="ListaValidacoes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#353544" BorderThickness="0,0,0,1" Padding="4,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding RuleId}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#52B788" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="10" Foreground="#C5C5D2" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding EvidenceDisplay}" FontSize="9" Foreground="#8A8A9E" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- SEÇÃO TEMPO DO PROJETO (OXCAD 0.5.0) -->
                <TextBlock Text="TEMPO DO PROJETO" FontSize="10" FontWeight="SemiBold" Foreground="#7E7E94" Margin="0,4,0,6" />

                <Border Background="#20202A" CornerRadius="6" Padding="10" BorderBrush="#353548" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Grid Estado e Início -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel>
                                <TextBlock Text="ESTADO" FontSize="9" FontWeight="SemiBold" Foreground="#8A8A9E"/>
                                <TextBlock x:Name="TxtTempoEstado" Text="Não iniciado" FontSize="12" FontWeight="Bold" Foreground="#9E9EB0" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="INÍCIO" FontSize="9" FontWeight="SemiBold" Foreground="#8A8A9E" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtTempoInicio" Text="-" FontSize="10" Foreground="#E2E2EC" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tempo Trabalhado (Destaque Principal) -->
                        <Border Background="#16161E" CornerRadius="4" Padding="8,6" Margin="0,2,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TEMPO TRABALHADO" FontSize="8" FontWeight="SemiBold" Foreground="#7A7A8E"/>
                                    <TextBlock x:Name="TxtTempoFormatado" Text="00:00:00" FontSize="18" FontWeight="Bold" Foreground="#52B788" Margin="0,2,0,0" FontFamily="Consolas, Segoe UI, monospace"/>
                                </StackPanel>
                                
                                <StackPanel x:Name="PainelTempoFim" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed" HorizontalAlignment="Right">
                                    <TextBlock Text="CONCLUSÃO" FontSize="8" FontWeight="SemiBold" Foreground="#7A7A8E" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="TxtTempoFim" Text="-" FontSize="10" Foreground="#E2E2EC" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Botões de Controle de Tempo -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Iniciar / Retomar / Pausar -->
                            <Button x:Name="BtnTempoAcaoPrincipal" Content="▶ Iniciar" Height="28" Margin="0,0,3,0"
                                    Background="#2A4B3C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" BorderThickness="0"
                                    Cursor="Hand" Click="BtnTempoAcaoPrincipal_Click" />

                            <!-- Concluir -->
                            <Button x:Name="BtnTempoConcluir" Grid.Column="1" Content="✓ Concluir" Height="28" Margin="3,0,0,0"
                                    Background="#3A3A4C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" BorderThickness="0"
                                    Cursor="Hand" Click="BtnTempoConcluir_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="CONTEXTO OPERACIONAL" FontSize="10" FontWeight="SemiBold" Foreground="#7E7E94" Margin="0,0,0,6" />

                <!-- STATUS CARD -->
                <Border Background="#282832" CornerRadius="6" Padding="10" BorderBrush="#353544" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="STATUS DO PROJETO" FontSize="9" FontWeight="SemiBold" Foreground="#9E9EB0" />
                        <TextBlock x:Name="TxtStatus" Text="Consultando..." FontSize="13" FontWeight="Bold" Foreground="#F77F00" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- SOB CARD -->
                <Border Background="#282832" CornerRadius="6" Padding="10" BorderBrush="#353544" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="IDENTIFICADOR SOB" FontSize="9" FontWeight="SemiBold" Foreground="#9E9EB0" />
                        <TextBlock x:Name="TxtSob" Text="-" FontSize="14" FontWeight="Bold" Foreground="#4EA8DE" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- DWG CARD -->
                <Border Background="#282832" CornerRadius="6" Padding="10" BorderBrush="#353544" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="DESENHO (DWG)" FontSize="9" FontWeight="SemiBold" Foreground="#9E9EB0" />
                        <TextBlock x:Name="TxtDwg" Text="-" FontSize="11" FontWeight="Normal" Foreground="#FFFFFF" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- PASTA CARD -->
                <Border Background="#282832" CornerRadius="6" Padding="10" BorderBrush="#353544" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="DIRETÓRIO DA SOB" FontSize="9" FontWeight="SemiBold" Foreground="#9E9EB0" />
                        <TextBlock x:Name="TxtPasta" Text="-" FontSize="10" FontWeight="Normal" Foreground="#C5C5D2" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- METADADOS CARD -->
                <Border Background="#282832" CornerRadius="6" Padding="10" BorderBrush="#353544" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="LOCALIZAÇÃO &amp; METADADOS" FontSize="9" FontWeight="SemiBold" Foreground="#9E9EB0" Margin="0,0,0,4" />
                        
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Município:" FontSize="10" Foreground="#8A8A9E"/>
                            <TextBlock x:Name="TxtMunicipio" Grid.Column="1" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="#E2E2EC"/>
                        </Grid>

                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bairro:" FontSize="10" Foreground="#8A8A9E"/>
                            <TextBlock x:Name="TxtBairro" Grid.Column="1" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="#E2E2EC"/>
                        </Grid>

                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Endereço:" FontSize="10" Foreground="#8A8A9E"/>
                            <TextBlock x:Name="TxtEndereco" Grid.Column="1" Text="-" FontSize="10" Foreground="#E2E2EC" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SEÇÃO MATRIZ DE ARTEFATOS -->
                <TextBlock Text="ARTEFATOS DO PROJETO" FontSize="10" FontWeight="SemiBold" Foreground="#7E7E94" Margin="0,2,0,6" />

                <Border Background="#24242E" CornerRadius="6" Padding="8" BorderBrush="#353544" BorderThickness="1" Margin="0,0,0,8">
                    <ItemsControl x:Name="ListaArtefatos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2,0,2" Padding="6,4" Background="#2A2A36" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Ícone -->
                                        <TextBlock Text="{Binding Icone}" FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#707085"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Existe}" Value="True">
                                                            <Setter Property="Foreground" Value="#52B788"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Rótulo -->
                                        <TextBlock Grid.Column="1" Text="{Binding Rotulo}" FontSize="11" 
                                                   VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A0A0B0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Existe}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Ação / Status do Item -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📂 Abrir" FontSize="9" Padding="6,2" Margin="0,0,4,0"
                                                    Background="#3A3A4C" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                                                    Click="BtnAbrirItem_Click" Tag="{Binding Caminho}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Existe}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Indicação específica para Unifilar -->
                                            <TextBlock Text="AutoCAD" FontSize="9" Foreground="#F4A261" Margin="2,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Chave}" Value="UNIFILAR">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- SEÇÃO INDICADORES DE PROCESSO (P2.2) -->
                <TextBlock Text="INDICADORES DE PROCESSO" FontSize="10" FontWeight="SemiBold" Foreground="#7E7E94" Margin="0,4,0,6" />

                <Border Background="#20202A" CornerRadius="6" Padding="10" BorderBrush="#353548" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Header com botão consultar e seletor de escopo -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ESCOPO:" FontSize="9" FontWeight="SemiBold" Foreground="#8A8A9E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtIndicadoresEscopo" Text="SOB Atual" FontSize="10" FontWeight="Bold" Foreground="#4EA8DE" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="BtnConsultarIndicadores" Grid.Column="1" Content="📊 Consultar" Height="24" Padding="8,2"
                                    Background="#2A3B4C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" BorderThickness="0"
                                    Cursor="Hand" Click="BtnConsultarIndicadores_Click" />
                        </Grid>

                        <!-- Indicador de Carregamento e Atualização -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtIndicadoresStatus" Text="Indicadores não consultados." FontSize="10" Foreground="#8A8A9E"/>
                            <TextBlock x:Name="TxtIndAtualizadoEm" Grid.Column="1" Text="" FontSize="9" Foreground="#6E6E82"/>
                        </Grid>

                        <!-- Painel de Métricas -->
                        <StackPanel x:Name="PainelIndicadoresMetricas" Visibility="Collapsed">
                            <!-- Metadados de Qualidade e Cobertura (P2.3) -->
                            <Grid Margin="0,1,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtIndCobertura" Text="COBERTURA: COMPLETA" FontSize="9" FontWeight="Bold" Foreground="#52B788"/>
                                <TextBlock x:Name="TxtIndPeriodo" Grid.Column="1" Text="Período: N/D" FontSize="8" Foreground="#8A8A9E"/>
                            </Grid>

                            <!-- Grid Execuções -->
                            <Border Background="#16161E" CornerRadius="4" Padding="6,4" Margin="0,2,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="EXECUÇÕES" FontSize="8" FontWeight="SemiBold" Foreground="#7A7A8E"/>
                                        <TextBlock x:Name="TxtIndTotalExec" Text="0" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CONCLUÍDAS" FontSize="8" FontWeight="SemiBold" Foreground="#7A7A8E"/>
                                        <TextBlock x:Name="TxtIndConcluidas" Text="0" FontSize="13" FontWeight="Bold" Foreground="#52B788" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="FALHAS" FontSize="8" FontWeight="SemiBold" Foreground="#7A7A8E"/>
                                        <TextBlock x:Name="TxtIndFalhas" Text="0" FontSize="13" FontWeight="Bold" Foreground="#E76F51" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Taxa e Duração -->
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtIndTaxaConclusao" Text="Taxa de sucesso: -" FontSize="9" Foreground="#C5C5D2"/>
                                <TextBlock x:Name="TxtIndDuracaoP95" Grid.Column="1" Text="P95: -" FontSize="9" Foreground="#C5C5D2" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Resumo Pendências & Entregas -->
                            <Border Background="#252532" CornerRadius="4" Padding="6,4" Margin="0,2,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PENDÊNCIAS" FontSize="8" FontWeight="SemiBold" Foreground="#7A7A8E"/>
                                        <TextBlock x:Name="TxtIndPendencias" Text="-" FontSize="10" Foreground="#E2E2EC" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ENTREGAS" FontSize="8" FontWeight="SemiBold" Foreground="#7A7A8E"/>
                                        <TextBlock x:Name="TxtIndEntregas" Text="-" FontSize="10" Foreground="#E2E2EC" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Fontes e Limitações / Observações (P2.3) -->
                            <TextBlock x:Name="TxtIndFontes" Text="Fontes: N/D" FontSize="8" Foreground="#85859B" TextTrimming="CharacterEllipsis" Margin="0,2,0,1"/>
                            <TextBlock x:Name="TxtIndObservacoes" Text="Log rotativo ativo (janela observada limitada)." FontSize="8" Foreground="#707085" TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SEÇÃO INTEGRAÇÕES (P2.4) -->
                <TextBlock Text="INTEGRAÇÕES" FontSize="10" FontWeight="SemiBold" Foreground="#7E7E94" Margin="0,4,0,6" />

                <Border Background="#20202A" CornerRadius="6" Padding="10" BorderBrush="#353548" BorderThickness="1" Margin="0,0,0,10">
                    <ItemsControl x:Name="ListaIntegracoes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="#C5C5D2" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{Binding StatusBackground}" CornerRadius="3" Padding="6,2">
                                        <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- SEÇÃO VALIDAÇÃO DE CAMPO (P2.5) -->
                <TextBlock Text="VALIDAÇÃO DE CAMPO" FontSize="10" FontWeight="SemiBold" Foreground="#7E7E94" Margin="0,4,0,6" />

                <Border Background="#20202A" CornerRadius="6" Padding="10" BorderBrush="#353548" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Cabeçalho de Modos com Badge -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Modo Operacional:" FontSize="9" Foreground="#85859B"/>
                                <TextBlock x:Name="TxtModoOperacional" Text="OFFLINE" FontSize="11" FontWeight="Bold" Foreground="#E2E2EC"/>
                            </StackPanel>
                            <Border Grid.Column="1" x:Name="BadgeModoOperacional" Background="#2C2C3E" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBadgeModo" Text="LOCAL" FontSize="9" FontWeight="SemiBold" Foreground="#82AAFF"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TxtMensagemOperacional" Text="Operação local disponível; sincronização externa pendente." FontSize="8.5" Foreground="#A0A0B4" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- 4 Dimensões de Estado -->
                        <Border Background="#181822" CornerRadius="4" Padding="6,4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,1">
                                    <TextBlock Text="Núcleo Local:" FontSize="8" Foreground="#656578"/>
                                    <TextBlock x:Name="TxtCoreStatus" Text="AVAILABLE" FontSize="9" FontWeight="SemiBold" Foreground="#52B788"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,1">
                                    <TextBlock Text="Conectividade:" FontSize="8" Foreground="#656578"/>
                                    <TextBlock x:Name="TxtConnectivityMode" Text="OFFLINE" FontSize="9" FontWeight="SemiBold" Foreground="#DDA15E"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,3,0,1">
                                    <TextBlock Text="Integrações:" FontSize="8" Foreground="#656578"/>
                                    <TextBlock x:Name="TxtIntegrationAvailability" Text="NOT_CONFIGURED" FontSize="9" FontWeight="SemiBold" Foreground="#85859B"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3,0,1">
                                    <TextBlock Text="Capacidade:" FontSize="8" Foreground="#656578"/>
                                    <TextBlock x:Name="TxtOperationalCapability" Text="LOCAL_EXEC" FontSize="9" FontWeight="SemiBold" Foreground="#82AAFF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Identidade e Soberania -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SOB" FontSize="8" Foreground="#656578"/>
                                <TextBlock x:Name="TxtCampoSOB" Text="-" FontSize="9" FontWeight="SemiBold" Foreground="#C5C5D2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DWG" FontSize="8" Foreground="#656578"/>
                                <TextBlock x:Name="TxtCampoDWG" Text="CONFIRMADO" FontSize="9" FontWeight="SemiBold" Foreground="#52B788"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FINGERPRINT" FontSize="8" Foreground="#656578"/>
                                <TextBlock x:Name="TxtCampoFingerprint" Text="CONFIRMADO" FontSize="9" FontWeight="SemiBold" Foreground="#52B788"/>
                            </StackPanel>
                        </Grid>

                        <!-- Checklist Sumário -->
                        <Border Background="#181822" CornerRadius="4" Padding="6,4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="OK" FontSize="8" FontWeight="SemiBold" Foreground="#52B788" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtChecklistOk" Text="0" FontSize="11" FontWeight="Bold" Foreground="#E2E2EC" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="ALERTA" FontSize="8" FontWeight="SemiBold" Foreground="#E0A96D" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtChecklistAlerta" Text="0" FontSize="11" FontWeight="Bold" Foreground="#E2E2EC" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="ERRO" FontSize="8" FontWeight="SemiBold" Foreground="#E63946" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtChecklistErro" Text="0" FontSize="11" FontWeight="Bold" Foreground="#E2E2EC" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="NÃO VERIF." FontSize="8" FontWeight="SemiBold" Foreground="#85859B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtChecklistNaoVerificado" Text="0" FontSize="11" FontWeight="Bold" Foreground="#E2E2EC" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Métricas Locais -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="EVIDÊNCIAS" FontSize="8" Foreground="#656578"/>
                                <TextBlock x:Name="TxtCampoEvidencias" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#C5C5D2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PENDÊNCIAS" FontSize="8" Foreground="#656578"/>
                                <TextBlock x:Name="TxtCampoPendencias" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#C5C5D2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SYNC PENDENTE" FontSize="8" Foreground="#656578"/>
                                <TextBlock x:Name="TxtCampoSincronizacoes" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#C5C5D2"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ACTION STATUS BAR -->
        <Border Grid.Row="3" Background="#22222C" CornerRadius="4" Padding="8,4" Margin="0,8,0,4" BorderBrush="#353544" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtAcaoEstado" Text="Pronto" FontSize="10" FontWeight="Bold" Foreground="#52B788" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="TxtAcaoMensagem" Grid.Column="1" Text="Nenhuma ação em execução." FontSize="10" Foreground="#A0A0B0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- REFRESH BUTTON COM CONTROLE DE CONCORRÊNCIA -->
        <StackPanel Grid.Row="4" Margin="0,4,0,0">
            <Button x:Name="BtnAtualizar" Content="🔄 Atualizar Contexto" 
                    Height="34" FontWeight="SemiBold" FontSize="11"
                    Background="#0077B6" Foreground="#FFFFFF" BorderThickness="0"
                    Cursor="Hand" Click="BtnAtualizar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- FOOTER -->
        <TextBlock Grid.Row="5" Text="OXCAD 0.6.0 • AUX CAD" 
                   FontSize="10" Foreground="#5C5C70" 
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
