<UserControl x:Class="MapaCadPaleta.MapaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="450"
             Background="#F1F5F9" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra Superior Compacta -->
        <Border Grid.Row="0" Background="#1B365D" Padding="8,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🗺️ MAPA OSM &amp; COORDENADAS" 
                               Foreground="White" FontWeight="Bold" FontSize="12" 
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCapturarCad" Content="🎯 Ler CAD" 
                            Click="BtnCapturarCad_Click"
                            ToolTip="Clique para capturar uma coordenada diretamente no desenho DWG"
                            Background="#0284C7" Foreground="White" BorderThickness="0"
                            Padding="8,3" Margin="2,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnRecarregar" Content="🔄" 
                            Click="BtnRecarregar_Click"
                            ToolTip="Recarregar mapa"
                            Background="#334155" Foreground="White" BorderThickness="0"
                            Padding="6,3" Margin="2,0" Cursor="Hand" FontWeight="Bold" FontSize="11">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Container do WebView2 (Mapa Leaflet OSM / Satélite) -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView" />
            
            <!-- Indicador de Carregamento -->
            <Border x:Name="LoadingPanel" Background="#E2E8F0" Opacity="0.95" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Carregando Cartografia OSM..." 
                               FontWeight="Bold" Foreground="#1B365D" FontSize="14" 
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Background="#CBD5E1" Foreground="#0284C7"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Barra de Status Inferior -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="TxtStatus" Text="Pronto • Clique no mapa ou digite as coordenadas" 
                       FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
