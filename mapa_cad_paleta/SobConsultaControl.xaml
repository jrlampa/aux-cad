<UserControl x:Class="MapaCadPaleta.SobConsultaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B365D" Padding="14,10">
            <TextBlock Text="CONSULTA DE SOB · GOMNET"
                       Foreground="White" FontWeight="Bold" FontSize="13" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock x:Name="TxtContextoStatus" Text="Projeto ativo: identificando..." FontSize="11" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap" />
                <TextBlock Text="Número da SOB" FontWeight="SemiBold" Foreground="#1E293B" />
                <DockPanel Margin="0,6,0,12">
                    <Button x:Name="BtnConsultar" Content="Consultar GOMnet"
                            Click="BtnConsultar_Click" DockPanel.Dock="Right"
                            Background="#087E8B" Foreground="White" BorderThickness="0"
                            Padding="12,7" Margin="8,0,0,0" Cursor="Hand" />
                    <TextBox x:Name="TxtSob" MinWidth="120" FontSize="13"
                             VerticalContentAlignment="Center" Padding="7,6"
                             TextChanged="TxtSob_TextChanged" />
                </DockPanel>

                <Border x:Name="BorderAvisoDivergencia" Background="#FEF3C7" BorderBrush="#F59E0B"
                        BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="AVISO DE DIVERGÊNCIA DE CONTEXTO" FontWeight="Bold" FontSize="11" Foreground="#92400E" Margin="0,0,0,2" />
                        <TextBlock x:Name="TxtAvisoDivergencia" Foreground="#78350F" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="ProgressConsulta" Height="5" IsIndeterminate="True"
                             Visibility="Collapsed" Foreground="#087E8B" Margin="0,0,0,12" />

                <TextBlock x:Name="TxtSituacao" Text="Situação cadastral: ainda não consultada."
                           FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtResultado" Text="Informe a SOB para consultar os anexos."
                           Foreground="#475569" TextWrapping="Wrap" Margin="0,5,0,10" />

                <TextBlock Text="Arquivos vinculados" FontWeight="SemiBold" Foreground="#1E293B"
                           Margin="0,4,0,6" />
                <ListBox x:Name="LstAnexos" MinHeight="60" MaxHeight="190"
                         BorderBrush="#CBD5E1" Background="White" />

                <TextBlock Text="Diretório-base do download" FontWeight="SemiBold"
                           Foreground="#1E293B" Margin="0,16,0,6" />
                <DockPanel>
                    <Button x:Name="BtnSelecionarPasta" Content="Selecionar pasta"
                            Click="BtnSelecionarPasta_Click" DockPanel.Dock="Right"
                            Padding="9,6" Margin="8,0,0,0" />
                    <TextBox x:Name="TxtDestino" IsReadOnly="True" Padding="7,6"
                             VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Os arquivos serão salvos em PROJETO CONSULTADO dentro do diretório-base."
                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1"
                BorderThickness="0,1,0,0" Padding="12,9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnAbrirPasta" Content="Abrir pasta"
                        Click="BtnAbrirPasta_Click" IsEnabled="False"
                        Padding="10,6" Margin="0,0,8,0" />
                <Button x:Name="BtnBaixar" Content="Baixar Arquivos da SOB"
                        Click="BtnBaixar_Click" IsEnabled="False"
                        Background="#087E8B" Foreground="White" BorderThickness="0"
                        Padding="12,7" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
